# 環境変数のサンプルファイル
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
#
# .env.local は git にコミットしないでください（.gitignore で除外済み）

# 例: 外部サービスの接続先URL
# NEXT_PUBLIC_API_URL=https://api.example.com

# 例: 認証シークレット
# AUTH_SECRET=your-secret-here

# jev（TypeSafe AI）の API キー。使う場合は .env.local で先頭の # を外して値を入れる（docs/jev.md 参照）
# TYPESAFE_API_KEY=
