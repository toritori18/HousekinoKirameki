{
  "stack": "nextjs-ts",
  "description": "Next.js (Pages Router) + TypeScript + Vitest + Prettier",
  "install": "npm install",
  "devServer": {
    "command": "npm run dev",
    "port": 3000
  },
  "commands": {
    "lint": "npm run lint",
    "format": "npm run format",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "build": "npm run build"
  },
  "check": ["verify-docs", "lint", "typecheck", "test", "build"],
  "contributing": {
    ".ts": "docs/TS-contributing.md",
    ".tsx": "docs/TS-contributing.md",
    ".mjs": "docs/TS-contributing.md",
    ".css": "docs/TS-contributing.md",
    ".ps1": "docs/powershell-contributing.md"
  }
}
